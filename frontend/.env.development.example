# ---------------------------------------------------------------------------
# 前端开发环境变量（复制为 .env.development 使用，next dev 自动加载）
# BFF 直连后端 8000，不引入 local-gateway 网关
# ---------------------------------------------------------------------------

# BFF 转发目标：后端 uvicorn 服务地址
AGENT_API_URL=http://127.0.0.1:8000

# 前端日志级别（trace/debug/info/warn/error）
LOG_LEVEL=debug