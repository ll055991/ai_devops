# ================= 大模型（OpenAI 兼容接口） =================
# 必填：API Key 与接口地址
OPENAI_API_KEY=your-api-key
OPENAI_BASE_URL=https://your-llm-gateway.example.com/v1
OPENAI_MODEL=your-model-name
OPENAI_TEMPERATURE=0.0
# 是否启用模型思考模式（true/false）
OPENAI_ENABLE_THINKING=false
# 模型单次最大输出 token
MODEL_MAX_TOKENS=32768

# ================= 目标仓库（Git） =================
# 仓库地址和分支由用户在对话中指定，不做白名单校验
# 若拉取需要鉴权，填 GitLab 账号密码或 token；匿名可拉则留空
GITLAB_USER=
GITLAB_TOKEN=

# ================= 目标服务器（SSH 执行 git/docker） =================
SERVER_HOST=your-server-ip
SERVER_PORT=22
SERVER_USER=root
SERVER_PASSWORD=
# 优先用密钥则填路径，与 PASSWORD 二选一
# SERVER_SSH_KEY=

# ================= 部署产物命名白名单 =================
# 容器实例名白名单（docker run --name 的值），多值逗号分隔
CONTAINER_NAMES=my-app:my-tag,my-app
# 镜像名前缀（docker build -t 的值，构建产物必须以此开头），单值前缀匹配
IMAGE_PREFIX=my-app
# workspace 白名单（多值，逗号分隔）
WORKSPACES=/data/deploy/workspace
# 新镜像 tag 生成规则，demo 用时间戳（如 20260819-001）
IMAGE_TAG_FORMAT=%Y%m%d-%H%M%S
# 健康检查地址（容器端口 + 健康路径，按你的服务实际填）
HEALTH_URL=http://127.0.0.1:8080/healthz

# ================= 审批 =================
# 需要人工审批的工具列表，逗号分隔
APPROVAL_REQUIRED_TOOLS=stop_container,remove_container,start_container,write_workspace_file,delete_workspace_file,add_whitelist_entry,remove_whitelist_entry

# ================= 服务 =================
HOST=127.0.0.1
PORT=8000

# ================= 日志 =================
LOG_LEVEL=INFO
LOG_DIR=logs